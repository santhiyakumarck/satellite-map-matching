def draw_matching_visualization(

    drone,

    satellite,

    mkpts0,

    mkpts1,

    inlier_mask,

    estimated_x,

    estimated_y,

    frame_id

):

    """
    Draw matching result.
    """

    drone_vis = drone.copy()

    satellite_vis = satellite.copy()


    if len(drone_vis.shape) == 2:

        drone_vis = cv2.cvtColor(
            drone_vis,
            cv2.COLOR_GRAY2BGR
        )


    if len(satellite_vis.shape) == 2:

        satellite_vis = cv2.cvtColor(
            satellite_vis,
            cv2.COLOR_GRAY2BGR
        )


    # Draw matches

    for i in range(
        len(mkpts0)
    ):

        p0 = tuple(
            np.round(
                mkpts0[i]
            ).astype(int)
        )

        p1 = tuple(
            np.round(
                mkpts1[i]
            ).astype(int)
        )


        if (

            inlier_mask is not None
            and i < len(inlier_mask)
            and inlier_mask[i]

        ):

            line_color = (0, 255, 0)

        else:

            line_color = (0, 0, 255)


        cv2.circle(
            drone_vis,
            p0,
            3,
            line_color,
            -1
        )


        cv2.circle(
            satellite_vis,
            p1,
            3,
            line_color,
            -1
        )


    # Estimated position

    if (

        0 <= estimated_x < satellite_vis.shape[1]
        and
        0 <= estimated_y < satellite_vis.shape[0]

    ):

        cv2.drawMarker(

            satellite_vis,

            (
                int(estimated_x),
                int(estimated_y)
            ),

            (255, 0, 255),

            cv2.MARKER_CROSS,

            30,

            3

        )


    # Resize images to same height

    target_height = max(

        drone_vis.shape[0],

        satellite_vis.shape[0]

    )


    def resize_height(image):

        scale = (
            target_height
            / image.shape[0]
        )

        return cv2.resize(

            image,

            None,

            fx=scale,

            fy=scale,

            interpolation=cv2.INTER_AREA

        )


    drone_vis = resize_height(
        drone_vis
    )

    satellite_vis = resize_height(
        satellite_vis
    )


    combined = np.hstack(
        [
            drone_vis,
            satellite_vis
        ]
    )


    path = os.path.join(

        VIS_DIR,

        f"match_{frame_id:05d}.jpg"

    )


    cv2.imwrite(
        path,
        combined
    )


    return path


# ======================================================================
# FIND NEAREST GPS
# ======================================================================

def find_nearest_gps(
    timestamp_ns
):

    """
    Find GPS row with nearest timestamp.
    """

    idx = np.searchsorted(
        gps_timestamps,
        timestamp_ns
    )


    if idx == 0:

        nearest_idx = 0


    elif idx >= len(gps_timestamps):

        nearest_idx = len(
            gps_timestamps
        ) - 1


    else:

        before = idx - 1
        after = idx


        diff_before = abs(
            timestamp_ns
            - gps_timestamps[before]
        )


        diff_after = abs(
            timestamp_ns
            - gps_timestamps[after]
        )


        if diff_before <= diff_after:

            nearest_idx = before

        else:

            nearest_idx = after


    row = gps_df.iloc[
        nearest_idx
    ]


    gps_timestamp = int(
        row["_timestamp_ns"]
    )


    difference_ms = (

        abs(
            timestamp_ns
            - gps_timestamp
        )
        / 1_000_000.0

    )


    lat = float(
        row[lat_col]
    )

    lon = float(
        row[lon_col]
    )

    altitude = float(
        row[alt_col]
    )


    return (

        lat,

        lon,

        altitude,

        gps_timestamp,

        difference_ms

    )


