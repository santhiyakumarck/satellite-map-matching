def latlon_to_pixel(lat, lon):

    """
    Convert geographic coordinates to GeoTIFF pixel coordinates.
    """

    row, col = rowcol(
        src.transform,
        lon,
        lat
    )

    return float(col), float(row)


# ======================================================================
# MAP PIXEL -> LAT/LON
# ======================================================================

def pixel_to_latlon(x, y):

    """
    Convert satellite pixel coordinates to longitude/latitude.
    """

    lon, lat = xy(
        src.transform,
        y,
        x,
        offset="center"
    )

    return float(lat), float(lon)


# ======================================================================
# ESTIMATE GROUND FOOTPRINT
# ======================================================================

def calculate_ground_footprint(
    altitude_m,
    fov_deg=FOV_DEG
):

    """
    Estimate ground footprint assuming a nadir camera.

    For a square 90-degree FOV:

        footprint = 2 * altitude * tan(FOV/2)
    """

    altitude_m = abs(float(altitude_m))


    if altitude_m <= 0:

        return MIN_ROI_METERS


    half_angle = math.radians(
        fov_deg / 2.0
    )


    footprint = (

        2.0
        * altitude_m
        * math.tan(half_angle)

    )


    footprint *= ROI_MARGIN


    footprint = max(
        footprint,
        MIN_ROI_METERS
    )


    footprint = min(
        footprint,
        MAX_ROI_METERS
    )


    return footprint


# ======================================================================
# METERS -> MAP PIXELS
# ======================================================================

def meters_per_pixel():

    """
    Estimate map resolution in meters/pixel.

    Works for geographic CRS maps by converting
    longitude/latitude distance near the map center.
    """

    center_row = src.height / 2.0
    center_col = src.width / 2.0


    lon1, lat1 = xy(
        src.transform,
        center_row,
        center_col,
        offset="center"
    )


    lon2, lat2 = xy(
        src.transform,
        center_row,
        center_col + 1,
        offset="center"
    )


    lat_rad = math.radians(lat1)


    meters_lon = (

        (lon2 - lon1)
        * 111320.0
        * math.cos(lat_rad)

    )


    meters_lat = abs(

        (lat2 - lat1)
        * 110540.0

    )


    mx = abs(meters_lon)
    my = abs(meters_lat)


    if mx <= 0:

        mx = 1.0


    if my <= 0:

        my = 1.0


    return mx, my


