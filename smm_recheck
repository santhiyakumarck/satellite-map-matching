# ======================================================================
# CREATE AUTOMATIC ROI
# ======================================================================

def create_satellite_roi(
    lat,
    lon,
    altitude,
    frame_id
):

    """
    Create satellite ROI around the GPS/INS position.

    ROI size is automatically calculated from altitude
    and the 90-degree camera FOV.
    """

    center_x, center_y = latlon_to_pixel(
        lat,
        lon
    )


    footprint_m = calculate_ground_footprint(
        altitude
    )


    roi_width_px = int(
        footprint_m /
        MAP_M_PER_PIXEL_X
    )


    roi_height_px = int(
        footprint_m /
        MAP_M_PER_PIXEL_Y
    )


    # Safety minimum

    roi_width_px = max(
        roi_width_px,
        32
    )

    roi_height_px = max(
        roi_height_px,
        32
    )


    # Calculate window

    x0 = int(
        round(
            center_x
            - roi_width_px / 2
        )
    )


    y0 = int(
        round(
            center_y
            - roi_height_px / 2
        )
    )


    # Clip to map boundaries

    x0 = max(
        0,
        x0
    )

    y0 = max(
        0,
        y0
    )


    x1 = min(
        src.width,
        x0 + roi_width_px
    )

    y1 = min(
        src.height,
        y0 + roi_height_px
    )


    width = x1 - x0
    height = y1 - y0


    if width <= 10 or height <= 10:

        return None


    window = Window(
        x0,
        y0,
        width,
        height
    )


    # Read RGB

    if src.count >= 3:

        satellite = src.read(
            [1, 2, 3],
            window=window
        )

        satellite = np.transpose(
            satellite,
            (1, 2, 0)
        )


    else:

        gray = src.read(
            1,
            window=window
        )

        satellite = cv2.cvtColor(
            gray,
            cv2.COLOR_GRAY2BGR
        )


    # Convert to uint8

    if satellite.dtype != np.uint8:

        satellite = cv2.normalize(
            satellite,
            None,
            0,
            255,
            cv2.NORM_MINMAX
        ).astype(np.uint8)


    roi_path = os.path.join(
        ROI_DIR,
        f"roi_{frame_id:05d}.jpg"
    )


    cv2.imwrite(
        roi_path,
        cv2.cvtColor(
            satellite,
            cv2.COLOR_RGB2BGR
        )
    )


    return {

        "image": satellite,

        "x0": x0,

        "y0": y0,

        "width": width,

        "height": height,

        "center_x": center_x,

        "center_y": center_y,

        "footprint_m": footprint_m,

        "roi_path": roi_path

    }


# ======================================================================
# SUPERPOINT + SUPERGLUE MATCH
# ======================================================================

def run_superpoint_superglue(
    drone_image,
    satellite_image
):

    """
    Run SuperPoint + SuperGlue.
    """

    image0 = image_to_tensor(
        drone_image
    )

    image1 = image_to_tensor(
        satellite_image
    )


    with torch.no_grad():

        prediction = matching({

            "image0": image0,

            "image1": image1

        })


    keypoints0 = (

        prediction["keypoints0"][0]
        .detach()
        .cpu()
        .numpy()

    )


    keypoints1 = (

        prediction["keypoints1"][0]
        .detach()
        .cpu()
        .numpy()

    )


    matches0 = (

        prediction["matches0"][0]
        .detach()
        .cpu()
        .numpy()

    )


    confidence = (

        prediction["matching_scores0"][0]
        .detach()
        .cpu()
        .numpy()

    )


    valid = (

        matches0 > -1
    )


    mkpts0 = keypoints0[
        valid
    ]


    mkpts1 = keypoints1[
        matches0[valid]
    ]


    mconf = confidence[
        valid
    ]


    return (
        mkpts0,
        mkpts1,
        mconf
    )


# ======================================================================
# RANSAC HOMOGRAPHY
# ======================================================================

def calculate_homography(
    mkpts0,
    mkpts1
):

    """
    Estimate drone -> satellite homography.
    """

    if len(mkpts0) < MIN_MATCHES_FOR_HOMOGRAPHY:

        return None, None


    H, mask = cv2.findHomography(

        mkpts0,

        mkpts1,

        cv2.RANSAC,

        RANSAC_REPROJ_THRESHOLD

    )


    if H is None or mask is None:

        return None, None


    inlier_mask = mask.ravel().astype(bool)


    return H, inlier_mask


# ======================================================================
# ESTIMATE DRONE CENTER IN SATELLITE ROI
# ======================================================================

def estimate_satellite_position(
    H,
    drone_image_shape
):

    """
    Project the center of the drone image into
    the satellite ROI using the homography.
    """

    h, w = drone_image_shape[:2]


    center = np.array(
        [
            [
                [
                    w / 2.0,
                    h / 2.0
                ]
            ]
        ],
        dtype=np.float32
    )


    projected = cv2.perspectiveTransform(
        center,
        H
    )


    x = float(
        projected[0, 0, 0]
    )

    y = float(
        projected[0, 0, 1]
    )


    return x, y


