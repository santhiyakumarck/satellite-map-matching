        frame_path
    ):

        print(
            "WARNING: Frame not found:",
            frame_path
        )

        continue


    timestamp_ns = int(
        ts_row[frame_timestamp_col]
    )


    # ---------------------------------------------------------------
    # Start total timer
    # ---------------------------------------------------------------

    total_start = time.perf_counter()


    try:

        print()
        print("-" * 75)

        print(
            f"FRAME {frame_id}: {frame_filename}"
        )


        # ============================================================
        # LOAD DRONE FRAME
        # ============================================================

        drone_image = cv2.imread(
            frame_path
        )


        if drone_image is None:

            raise RuntimeError(
                "Could not read drone image."
            )


        # ============================================================
        # FIND GPS
        # ============================================================

        (

            gps_lat,

            gps_lon,

            gps_alt,

            gps_timestamp,

            gps_time_diff_ms

        ) = find_nearest_gps(
            timestamp_ns
        )


        print(
            f"GPS: {gps_lat:.8f}, "
            f"{gps_lon:.8f}, "
            f"alt={gps_alt:.3f} m"
        )


        print(
            f"Frame-GPS time difference: "
            f"{gps_time_diff_ms:.3f} ms"
        )


        # ============================================================
        # CREATE DYNAMIC SATELLITE ROI
        # ============================================================

        roi_start = time.perf_counter()


        roi = create_satellite_roi(

            gps_lat,

            gps_lon,

            gps_alt,

            frame_id

        )


        roi_time = (

            time.perf_counter()
            - roi_start

        )


        if roi is None:

            raise RuntimeError(
                "Could not create satellite ROI."
            )


        satellite_image = roi[
            "image"
        ]


        print(
            f"ROI: "
            f"{roi['width']} x "
            f"{roi['height']} pixels"
        )


        print(
            f"Estimated ground footprint: "
            f"{roi['footprint_m']:.2f} m"
        )


        # ============================================================
        # SUPERPOINT + SUPERGLUE
        # ============================================================

        matching_start = time.perf_counter()


        (

            mkpts0,

            mkpts1,

            mconf

        ) = run_superpoint_superglue(

            drone_image,

            satellite_image

        )


        matching_time = (

            time.perf_counter()
            - matching_start

        )


        total_matches = len(
            mkpts0
        )


        print(
            "SuperGlue matches:",
            total_matches
        )


        # ============================================================
        # RANSAC
        # ============================================================

        ransac_start = time.perf_counter()


        H, inlier_mask = calculate_homography(

            mkpts0,

            mkpts1

        )


        ransac_time = (

            time.perf_counter()
            - ransac_start

        )


        # Defaults

        inliers = 0

        inlier_ratio = 0.0

        estimated_x = np.nan

        estimated_y = np.nan

        estimated_lat = np.nan

        estimated_lon = np.nan

        position_error_m = np.nan

        status = "FAILED"


        # ============================================================
        # HOMOGRAPHY SUCCESS
        # ============================================================

        if H is not None:

            inliers = int(
                np.sum(
                    inlier_mask
                )
            )


            if total_matches > 0:

                inlier_ratio = (

                    inliers
                    / total_matches

                )


            print(
                "RANSAC inliers:",
                inliers
            )


            print(
                "Inlier ratio:",
                f"{inlier_ratio:.3f}"
            )


            # --------------------------------------------------------
            # Estimate center position
            # --------------------------------------------------------

            (

                estimated_x,

                estimated_y

            ) = estimate_satellite_position(

                H,

                drone_image.shape

            )


            # --------------------------------------------------------
            # Convert ROI pixel -> full map pixel
            # --------------------------------------------------------

            map_x = (

                roi["x0"]
                + estimated_x

            )


            map_y = (

                roi["y0"]
                + estimated_y

            )


            # --------------------------------------------------------
            # Convert pixel -> lat/lon
            # --------------------------------------------------------

            (

                estimated_lat,

                estimated_lon

            ) = pixel_to_latlon(

                map_x,

                map_y

            )


            # --------------------------------------------------------
            # Calculate geographic error
            # --------------------------------------------------------

            def haversine(

                lat1,

                lon1,

                lat2,

                lon2

            ):

                R = 6371000.0


                p1 = math.radians(
                    lat1
                )

                p2 = math.radians(
                    lat2
                )


                dp = math.radians(
                    lat2 - lat1
                )

                dl = math.radians(
                    lon2 - lon1
                )


                a = (

                    math.sin(dp / 2) ** 2

                    +

                    math.cos(p1)
                    * math.cos(p2)
                    * math.sin(dl / 2) ** 2

                )


                return (

                    2
                    * R
                    * math.asin(
                        math.sqrt(a)
                    )

                )


            position_error_m = haversine(

                gps_lat,

                gps_lon,

                estimated_lat,

                estimated_lon

            )


            if inliers >= MIN_RANSAC_INLIERS:

                status = "SUCCESS"

                successful += 1

            else:

                status = "LOW_INLIERS"


            print()
            print(
                "Estimated position:"
            )

            print(
                f"Latitude  : "
                f"{estimated_lat:.8f}"
            )

            print(
                f"Longitude : "
                f"{estimated_lon:.8f}"
            )

            print(
                f"Error     : "
                f"{position_error_m:.3f} m"
            )


        else:

            print(
                "RANSAC failed."
            )


        # ============================================================
        # VISUALIZATION
        # ============================================================

        visualization_path = ""


        if H is not None:

            visualization_path = (

                draw_matching_visualization(

                    drone_image,

                    satellite_image,

                    mkpts0,

                    mkpts1,

                    inlier_mask,

                    estimated_x,

                    estimated_y,

                    frame_id

                )

            )


        # ============================================================
        # TOTAL TIME
        # ============================================================

        total_time = (

            time.perf_counter()
            - total_start

        )


        print()
        print(
            f"ROI time      : "
            f"{roi_time * 1000:.2f} ms"
        )

        print(
            f"Matching time : "
            f"{matching_time * 1000:.2f} ms"
        )

        print(
            f"RANSAC time   : "
            f"{ransac_time * 1000:.2f} ms"
        )

        print(
            f"TOTAL time    : "
            f"{total_time * 1000:.2f} ms"
        )

        print(
            "STATUS        :",
            status
        )


        # ============================================================
        # SAVE RESULT
        # ============================================================

        results.append({

            "frame_id":
                frame_id,

            "frame_filename":
                frame_filename,

            "frame_timestamp_ns":
                timestamp_ns,

            "gps_timestamp_ns":
                gps_timestamp,

            "frame_gps_difference_ms":
                gps_time_diff_ms,

            "gps_latitude":
                gps_lat,

            "gps_longitude":
                gps_lon,

            "gps_altitude_m":
                gps_alt,

            "fov_deg":
                FOV_DEG,

            "roi_width_px":
                roi["width"],

            "roi_height_px":
                roi["height"],

            "roi_footprint_m":
                roi["footprint_m"],

            "superglue_matches":
                total_matches,

            "ransac_inliers":
                inliers,

            "inlier_ratio":
                inlier_ratio,

            "estimated_latitude":
                estimated_lat,

            "estimated_longitude":
                estimated_lon,

            "position_error_m":
                position_error_m,

            "roi_time_ms":
                roi_time * 1000,

            "matching_time_ms":
                matching_time * 1000,

            "ransac_time_ms":
                ransac_time * 1000,

            "total_processing_time_ms":
                total_time * 1000,

            "status":
                status,

            "visualization":
                visualization_path

        })


    except Exception as e:

        print()
        print(
            "ERROR processing frame:",
            frame_id
        )

        print(
            str(e)
        )

        traceback.print_exc()


        results.append({

            "frame_id":
                frame_id,

            "frame_filename":
                frame_filename,

            "frame_timestamp_ns":
                timestamp_ns,

            "status":
                "ERROR",

            "error_message":
                str(e)

        })


    processed += 1


